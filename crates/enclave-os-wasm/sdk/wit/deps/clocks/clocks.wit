// WASI Clocks — as implemented by Enclave OS (Mini).
//
// Wall clock: the enclave's trusted time (1 ms resolution). It never goes
// back, and a call traps when the enclave has no trusted time.
// Monotonic clock: the same time, in nanoseconds.

package wasi:clocks@0.2.0;

/// Wall-clock time (real-world calendar time).
///
/// The enclave's trusted time as a UNIX timestamp: checked against a
/// sealed floor, the platform monitor and NTS, never simply the host clock.
/// Resolution: 1 millisecond. Traps when there is no trusted time.
interface wall-clock {
    /// A point in time.
    record datetime {
        seconds: u64,
        nanoseconds: u32,
    }

    /// Current wall-clock time as UNIX timestamp.
    now: func() -> datetime;

    /// Clock resolution: 1 millisecond.
    resolution: func() -> datetime;
}

/// Monotonic clock (for measuring elapsed time).
///
/// The wall-clock time in nanoseconds; it never goes back.
/// Resolution: 1 millisecond (1,000,000 nanoseconds).
interface monotonic-clock {
    use wasi:io/poll@0.2.0.{pollable};

    /// Current time in nanoseconds.
    now: func() -> u64;

    /// Resolution in nanoseconds (1,000,000 = 1 millisecond).
    resolution: func() -> u64;

    /// Returns an always-ready pollable (synchronous model).
    subscribe-instant: func(when: u64) -> pollable;

    /// Returns an always-ready pollable.
    subscribe-duration: func(when: u64) -> pollable;
}
